{
	"schemaVersion": 1,
	"id": "foodoverhaul",
	"version": "${version}",
	"name": "Food Overhaul",
	"description": "Overhauls the food system to be similar to games like Valheim or Enshrouded.",
	"authors": [
		"TheRedBrain"
	],
	"contact": {
		"sources": "https://github.com/TheRedBrain/food-overhaul"
	},
	"license": "MIT",
	"icon": "assets/foodoverhaul/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.theredbrain.foodoverhaul.FoodOverhaul"
		],
		"client": [
			"com.github.theredbrain.foodoverhaul.FoodOverhaulClient"
		]
	},
	"custom": {
		"fzzy_config": [
			"foodoverhaul"
		]
	},
	"mixins": [
		"foodoverhaul.mixins.json",
		{
			"config": "foodoverhaul.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"fabric-api": "*",
		"fzzy_config": ">=${fzzy_config_version}"
	}
}